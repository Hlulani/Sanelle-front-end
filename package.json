{
  "name": "sanelle-front-end",
  "version": "0.0.1",
  "author": "Hlulani",
  "homepage": "https://github.com/Hlulani/Sanelle-front-end",
  "scripts": {
    "check:meal-photos": "node scripts/check-meal-photos.mjs",
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/build.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/forms": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@angular/platform-browser-dynamic": "^20.3.33",
    "@angular/router": "^20.3.33",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@ionic/angular": "^8.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "ionicons": "^7.0.0",
    "pdfjs-dist": "^6.4.299",
    "rxjs": "~7.8.0",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.37",
    "@angular-eslint/builder": "^20.7.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/schematics": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.33",
    "@angular/language-service": "^20.3.33",
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
